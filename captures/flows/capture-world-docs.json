{
  "name": "Capture the World Composer screenshots used by docs/doppio/world-composition.md",
  "description": "Run through scripts/capture-world-docs.sh (it strips the NNN- prefix). Needs the engine library for the build step.",
  "fixture": "world",
  "size": [
    1600,
    900
  ],
  "steps": [
    {
      "action": "wait",
      "ms": 600,
      "real_time": true,
      "label": "let the preview settle"
    },
    {
      "action": "screenshot",
      "name": "world-tab",
      "target": "id:editor.pane.world",
      "padding": 0
    },
    {
      "action": "click",
      "target": "id:world.composition.class_row.1",
      "label": "select the stone class"
    },
    {
      "action": "click",
      "target": "id:world.rules.add_term",
      "label": "give it a where term"
    },
    {
      "action": "click",
      "target": "id:world.toolbar.build",
      "label": "build the world"
    },
    {
      "action": "wait",
      "ms": 800,
      "real_time": true
    },
    {
      "action": "screenshot",
      "name": "world-built"
    },
    {
      "action": "reset",
      "fixture": "world_showcase",
      "size": [
        1600,
        900
      ],
      "label": "the showcase world: hills round a valley, a river, a lake, trees, rocks, shrubs and grass"
    },
    {
      "action": "click",
      "target": "id:world.toolbar.build",
      "label": "build it (a few thousand instances: the instance bake path)"
    },
    {
      "action": "click",
      "target": "id:world.toolbar.frame",
      "label": "frame the built world in the Viewport"
    },
    {
      "action": "wait",
      "ms": 2500,
      "real_time": true,
      "label": "let the viewport settle"
    },
    {
      "action": "screenshot",
      "name": "world-showcase",
      "target": "id:viewport.canvas.surface",
      "padding": 0
    }
  ]
}
