{
  "name": "Capture the Environment tab screenshots used by docs/doppio/environment-guide.md",
  "description": "Run through scripts/capture-environment-docs.sh (it strips the NNN- prefix). Needs the engine (fixture scene3d).",
  "fixture": "scene3d",
  "size": [1600, 1400],
  "steps": [
    {"action": "click", "target": "id:editor.menu.view", "label": "open the View menu"},
    {"action": "click", "target": "id:editor.menu.view.environment", "label": "open the Environment tab"},
    {"action": "screenshot", "name": "environment-empty", "target": "id:editor.pane.environment", "padding": 0},
    {"action": "click", "target": "id:environment.setup.add", "label": "add the environment"},
    {"action": "wait", "ms": 400, "real_time": true, "label": "let a few frames render"},
    {"action": "screenshot", "name": "environment-pane", "target": "id:editor.pane.environment", "padding": 0},
    {"action": "scroll", "target": "id:editor.pane.environment", "dy": -6, "label": "scroll the tab down to the fog"},
    {"action": "click", "target": "id:environment.fog.enabled", "offset": [-115, 0], "label": "fog on"},
    {"action": "scroll", "target": "id:editor.pane.environment", "dy": -6, "label": "scroll the tab down to the rain"},
    {"action": "click", "target": "id:environment.rain.enabled", "offset": [-115, 0], "label": "rain on"},
    {"action": "wait", "ms": 400, "real_time": true, "label": "let a few frames render"},
    {"action": "screenshot", "name": "environment-editor"}
  ]
}
